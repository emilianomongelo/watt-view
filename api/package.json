{
  "name": "growatt-plus-api",
  "version": "0.1.0",
  "description": "Solar energy monitoring system — Growatt Plus backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "verify:live": "node scripts/verify-live.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "LIVE_E2E=1 playwright test e2e/live"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.15.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "suncalc": "^2.0.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/suncalc": "^2.0.0",
    "eslint": "^10.0.0",
    "tsx": "^4.23.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
